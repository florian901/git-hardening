#!/usr/bin/env bash
# Doctest stub for the SecretSpec CLI. Never touches a real vault.
#
# Like the `op` stub, `get` emits DOCTEST_SECRET (a per-run nonce) so the
# harness can prove PROVENANCE: the value that crossed the wire came from
# secretspec, not from a literal the block hardcoded.
set -o errexit
set -o nounset
set -o pipefail
IFS=$'\n\t'

main() {
    local cmd="${1:-}"

    # IFS lacks a space here, so "$*" would join argv with newlines. Join with
    # spaces explicitly so the harness can match on the subcommand.
    { printf '%s ' "$@"; printf '\n'; } >> "${DOCTEST_LOG}/secretspec.argv"

    if [[ "${SECRETSPEC_STUB_FAIL:-0}" == "1" ]]; then
        printf 'secretspec stub: simulated failure\n' >&2
        return 1
    fi

    [[ -n "${DOCTEST_SECRET:-}" ]] || {
        printf 'secretspec stub: DOCTEST_SECRET not set\n' >&2
        return 1
    }

    case "${cmd}" in
        get)
            local name="${2:-}"
            [[ -n "${name}" ]] || {
                printf 'secretspec stub: get requires a secret name\n' >&2
                return 1
            }
            # Real `secretspec get` prints the bare value to stdout.
            printf '%s\n' "${DOCTEST_SECRET}"
            ;;
        check)
            # Exit 0 = every required secret is resolvable.
            ;;
        run)
            # Deliberately IMPLEMENTED so the harness forbids it by policy
            # rather than by accident. Real `secretspec run` injects the
            # secrets into the environment and execs; a guide block that uses
            # it across the SSH boundary must fail the scenario assertion, not
            # merely hit an unimplemented stub.
            shift
            while (($# > 0)); do
                if [[ "$1" == '--' ]]; then
                    shift
                    break
                fi
                shift
            done
            (($# > 0)) || return 0
            DB_PASSWORD="${DOCTEST_SECRET}" API_KEY="${DOCTEST_SECRET}" "$@"
            ;;
        *)
            printf 'secretspec stub: unsupported invocation: %s\n' "$*" >&2
            return 1
            ;;
    esac
}

main "$@"
